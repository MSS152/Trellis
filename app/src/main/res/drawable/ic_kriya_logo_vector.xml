<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background Circle Shield -->
    <path
        android:pathData="M54,54m-48,0a48,48 0,1 1,96 0a48,48 0,1 1,-96 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0F172A" />
                <item android:offset="1.0" android:color="#FF1E293B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Progress Track Background Ring -->
    <path
        android:strokeColor="#333882F6"
        android:strokeWidth="6"
        android:pathData="M54,12A42,42 0,1 1,12 54" />

    <!-- Progress Track Active Glowing Ring -->
    <path
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M54,12A42,42 0,1 1,96 54">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="12"
                android:startY="12"
                android:endX="96"
                android:endY="96"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3B82F6" />
                <item android:offset="0.5" android:color="#FF06B6D4" />
                <item android:offset="1.0" android:color="#FF10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Modern Crisp Checkmark Emblem -->
    <path
        android:pathData="M34,54 L48,68 L74,38"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Energy Accent Dot at Ring End -->
    <path
        android:pathData="M96,54 A 3.5,3.5 0 1,1 96,54.1"
        android:fillColor="#FF10B981" />

</vector>
